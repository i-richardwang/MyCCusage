# Reference for environment injection; the collector does not auto-load .env files.
# Once injected, run: ccusage-collector sync

# Required credentials. Use the complete sync endpoint, not only the domain.
MYCCUSAGE_API_KEY=your-api-key-here
MYCCUSAGE_ENDPOINT=https://example.com/api/usage-sync

# Optional comma-separated agents (default: claude-code).
# Supported: claude-code,amp,opencode,codex,dimagent,cursor,antigravity
MYCCUSAGE_AGENT_TYPES=claude-code,codex

# Optional device identity; each field independently falls back to JSON/defaults.
# Choose a distinct ID per independent usage dataset.
MYCCUSAGE_DEVICE_ID=cloud-dev-01
MYCCUSAGE_DEVICE_NAME=cloud-dev-01
MYCCUSAGE_DISPLAY_NAME="Cloud development"

# Optional comma-separated Claude Code config directories (absolute or ~/ paths).
# Scoped to the claude-code collection; replaces ccusage's default lookup.
# MYCCUSAGE_CLAUDE_CONFIG_DIRS=~/.claude,/path/to/another/claude/config
