{
  "name": "ccusage-collector",
  "version": "0.6.0",
  "description": "Local collector for Claude Code usage statistics",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ccusage-collector": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-pricing": "tsx scripts/update-pricing.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "usage",
    "collector",
    "statistics",
    "cli",
    "monitoring",
    "dashboard"
  ],
  "author": "Richard Wang",
  "repository": {
    "type": "git",
    "url": "https://github.com/i-richardwang/MyCCusage.git",
    "directory": "packages/ccusage-collector"
  },
  "bugs": {
    "url": "https://github.com/i-richardwang/MyCCusage/issues"
  },
  "homepage": "https://github.com/i-richardwang/MyCCusage#readme",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "devDependencies": {
    "@types/node": "^20",
    "@types/proper-lockfile": "^4.1.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.20.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "commander": "^14.0.0",
    "cron-parser": "^5.10.2",
    "inquirer": "^12.1.0",
    "proper-lockfile": "^4.1.2"
  }
}
